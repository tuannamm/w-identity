{
  "name": "w-identity",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,mjs}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand",
    "test:debug": "NODE_OPTIONS=--experimental-vm-modules node --inspect-brk ../../node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-integration.config.cjs --selectProjects e2e --runInBand",
    "docs:knowledge": "node scripts/build-knowledge-html.mjs",
    "test:mongo": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-integration.config.cjs --selectProjects mongo --runInBand",
    "test:profile": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest-integration.config.cjs --selectProjects profile --runInBand"
  },
  "dependencies": {
    "@lib-infrastructure/core": "^0.0.1",
    "@lib-infrastructure/database": "^0.0.1",
    "@lib-infrastructure/keycloak": "^0.0.1",
    "@lib-infrastructure/rabbitmq": "^0.0.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/cqrs": "^12.1.2",
    "@nestjs/microservices": "^12.4.0",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "mongoose": "^9.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "amqplib": "^2.2.1",
    "jest": "^30.0.0",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "smtp-server": "^3.21.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "nx": {
    "targets": {
      "test:e2e": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "test:mongo": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "test:profile": {
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "test:cov": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      },
      "test:watch": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      },
      "test:debug": {
        "dependsOn": [
          "^build"
        ],
        "cache": false
      }
    }
  }
}
