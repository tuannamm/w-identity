PORT=4002
IDENTITY_HOST=127.0.0.1
HEALTH_PORT=9002
SERVICE_NAME=w-identity
SERVICE_ADVERTISE_HOST=127.0.0.1
REGISTRY_URL=http://localhost:8500
RABBITMQ_URI=amqp://guest:guest@localhost:5672
RABBITMQ_QUEUE=w-identity
MONGODB_URI=mongodb://admin:admin123@localhost:27017/w-identity?authSource=admin
# Shared @lib-infrastructure/keycloak connection (service account)
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=pm
KEYCLOAK_CLIENT_ID=identity-service
KEYCLOAK_CLIENT_SECRET=dev-identity-secret
KEYCLOAK_TIMEOUT_MS=3000
# Worker authorization of the actor supplied by the gateway
KEYCLOAK_ISSUER=http://localhost:8081/realms/pm
# Temporary password given to every account created via the API (default 123).
# Keycloak forces a change at first login. Dev only: set something unguessable elsewhere.
DEFAULT_USER_PASSWORD=123
# First admin, created by the script `npm run seed:admin` (idempotent). Not used at service boot.
# The password is TEMPORARY (Keycloak forces a change at first login), min 3 characters.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
